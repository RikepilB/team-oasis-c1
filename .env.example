# Copy this file to .env.local and fill it in. .env.local is never committed (see .gitignore).

# Demo data that ships with the app
SYNAPSE_DATA_DIR=data/fixtures/demo

# AI mode: "replay" (default, recorded answers, no key or internet) or "live" (calls the model)
AI_MODE=replay

# Only needed for AI_MODE=live. Keep it secret; never paste it into code, chat or a commit.
ANTHROPIC_API_KEY=

# Optional: which Claude model live mode uses (default claude-haiku-5-5)
# SYNAPSE_MODEL=claude-haiku-5-5
