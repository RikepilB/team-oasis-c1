{
  "name": "synapse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "dev:site": "npm run dev --workspace @synapse/site",
    "build:site": "npm run build --workspace @synapse/site",
    "preview:site": "npm run preview --workspace @synapse/site",
    "db:migrate": "node scripts/migrate.mjs",
    "build:all": "npm run build && npm run build:site",
    "template": "node scripts/template.mjs",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "next": "16.4.2",
    "papaparse": "^5.7.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "workspaces": [
    "apps/site"
  ]
}
